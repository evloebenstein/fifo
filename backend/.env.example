# =============================================================================
# FIFO BACKEND - VARIABLES DE ENTORNO (.env)
# =============================================================================
# Copia este archivo a `.env` en la carpeta backend/ y personaliza las contraseñas:
#   cp .env.example .env
#
# NUNCA subas el archivo `.env` con contraseñas reales a GitHub (está en .gitignore).
# =============================================================================

# --- MySQL 8.4 LTS Database ---
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root_super_secreta
MYSQL_DATABASE=fifo_db
MYSQL_USER=fifo_app
MYSQL_PASSWORD=cambia_esta_contrasena_app_segura
MYSQL_PORT=3306

# --- FastAPI REST API (Microservicio) ---
API_PORT=8090
DB_HOST=fifo-mysql
DB_PORT=3306
DB_NAME=fifo_db
DB_USER=fifo_app
DB_PASSWORD=cambia_esta_contrasena_app_segura

# --- Panel Web Adminer ---
ADMINER_PORT=8080

# --- Modelos de Inteligencia Artificial (Backend Pattern & Dot-Connecting Engine) ---
# Groq ofrece API 100% gratuita con modelos de alta fidelidad como llama-3.3-70b-versatile o qwen/qwen3.8-27b
GROQ_API_KEY=
# Opcional: Google Gemini API (clave gratuita de Google AI Studio)
GEMINI_API_KEY=
